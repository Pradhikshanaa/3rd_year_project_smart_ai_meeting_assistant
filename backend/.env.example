# Database Configuration (SQLite default; can be overridden if using MySQL/PostgreSQL)
# DATABASE_URL=sqlite:///smart_meeting.db
# Or if using MySQL: DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_meeting_db

# Security
SECRET_KEY=smart-ai-meeting-assistant-secret-2026-key

# Google Gemini API
GEMINI_API_KEY=

# SMTP Email Configuration (Flask-Mail & standard SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-16-char-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SENDER_EMAIL=your-email@gmail.com

# SMTP Compatibility Aliases (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-16-char-app-password
# SMTP_SENDER_EMAIL=your-email@gmail.com

# Frontend URL (for direct dashboard / task links in emails)
FRONTEND_URL=http://localhost:5173
